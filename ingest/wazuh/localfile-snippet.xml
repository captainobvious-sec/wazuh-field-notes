<!--
  Wazuh manager ossec.log (rules 116300-116307: authd enrolment and remoted key errors).
  The default manager config has NO localfile for ossec.log, so none of these lines reach
  the rules until this is added to the MANAGER ossec.conf. Message text is from 4.14.x;
  5.x logs enrolment differently (see docs/vuln-coverage.md).
-->
<localfile>
  <log_format>syslog</log_format>
  <location>/var/ossec/logs/ossec.log</location>
</localfile>
