<!--
  Proxmox VE + PBS rules v2 (homelab) — wazuh-review 2026-09-26
  Replaces: /var/ossec/etc/rules/proxmox_rules.xml (v1, 2026-07-09)
  Requires: decoders/proxmox_pve_pbs_decoders.xml v2
  Agents: pm, pm2 (PVE 9.1, standalone, not clustered), pbs, pbs2 (PBS 4) — journald
  Rule range: 100800-100899

  WHY v2 (evidence in IZVJESTAJ.md):
    * 100806 "login succeeded after brute force" (level 12) fired 73x = PegaProx on pm2 using a
      non-existent API token ("no such token 'pegaprox_000000'", 2,206 failures) followed by a normal
      root@pam login. Token/ticket errors are now a separate low-level rule and do not feed brute force.
    * 100815 looked for "delete VM" - PVE logs "destroy VM 104: UPID:...:qmdestroy:...". Never fired.
    * 100810/100811 (pveum) can never fire: user/token/ACL changes are NOT written to journald by PVE
      (only to /var/log/pveproxy/access.log) -> replaced by FIM on /etc/pve access-control files.
    * PBS 100860/100862/100865/100866 matched texts that PBS 4 only writes to task logs, never journald.
      Real journald texts ("unable to open chunk store", "unable to start datastore ... job",
      "Upload backup log to datastore") are covered now.
    * Correlations had no same_srcip/same_field (they counted events from ALL agents together).

  RETIRED IDs (do not reuse): 100810, 100811, 100855, 100856, 100857, 100860, 100861, 100865, 100866
-->

<group name="proxmox,">

  <!-- ================================================================== -->
  <!-- PVE AUTHENTICATION                                                 -->
  <!-- ================================================================== -->

  <!-- pveproxy "authentication failure: ..." is claimed by stock 2501 (verified in logtest). -->
  <rule id="100800" level="5">
    <if_sid>2501</if_sid>
    <program_name>^pveproxy$</program_name>
    <match>authentication failure</match>
    <description>Proxmox VE: API/web authentication failure: $(pve.status)</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,</group>
  </rule>

  <!-- Stale token / expired ticket = broken integration (PegaProx, Pulse), not password guessing -->
  <rule id="100802" level="4">
    <if_sid>100800</if_sid>
    <regex type="pcre2">(?i)no such token|invalid token|invalid PVE ticket|ticket expired|invalid ticket</regex>
    <description>Proxmox VE: API token/ticket rejected - $(pve.status) - integration misconfigured</description>
    <group>authentication_failed,integration,</group>
  </rule>

  <rule id="100803" level="7" frequency="20" timeframe="600" ignore="3600">
    <if_matched_sid>100802</if_matched_sid>
    <same_location />
    <description>Proxmox VE: 20+ rejected API tokens/tickets in 10 min - an integration keeps failing (e.g. PegaProx)</description>
    <group>authentication_failed,integration,</group>
  </rule>

  <rule id="100801" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100800</if_matched_sid>
    <same_location />
    <description>Proxmox VE: 5+ API/web authentication failures in 2 min</description>
    <mitre><id>T1110.001</id></mitre>
    <group>authentication_failures,</group>
  </rule>

  <!-- pvedaemon password failure ("authentication failure; rhost=IP user=U@realm msg=...").
       Stock decoder pvedaemon-auth-failed extracts srcip/user. Chained on BOTH candidates because
       the claiming rule (stock 87201 vs generic 2501) must be confirmed in the sandbox (no real sample yet). -->
  <rule id="100804" level="6">
    <if_sid>87201, 2501</if_sid>
    <program_name>^pvedaemon$</program_name>
    <match>authentication failure; rhost=</match>
    <description>Proxmox VE: login failed for $(dstuser) from $(srcip)</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100806" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100804</if_matched_sid>
    <same_srcip />
    <description>Proxmox VE: brute force - 5+ failed logins in 2 min from $(srcip)</description>
    <mitre><id>T1110.001</id></mitre>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100805" level="3">
    <if_sid>87203</if_sid>
    <match>successful auth for user</match>
    <description>Proxmox VE: successful login $(dstuser)</description>
    <group>authentication_success,</group>
    <options>no_full_log</options>
  </rule>

  <!-- root@pam: lowered 8 -> 5 (3,448 alerts, mostly automation). Raise again once PegaProx/Pulse use own users/tokens. -->
  <rule id="100807" level="5">
    <if_sid>100805</if_sid>
    <match>successful auth for user 'root@pam'</match>
    <description>Proxmox VE: root@pam login</description>
    <mitre><id>T1078.003</id></mitre>
    <group>authentication_success,</group>
  </rule>

  <rule id="100808" level="12">
    <if_sid>100805</if_sid>
    <if_matched_sid>100806</if_matched_sid>
    <same_location />
    <description>Proxmox VE: login SUCCEEDED shortly after a password brute force - possible compromised credentials</description>
    <mitre><id>T1078</id><id>T1110</id></mitre>
    <group>authentication_success,</group>
  </rule>

  <!-- Access-control changes (users, tokens, TFA, realms, ACL) - PVE does not log them to journald.
       FIM (default <syscheck> covers /etc, scan every 12 h) is the only source without access.log. -->
  <rule id="100812" level="10">
    <if_sid>550, 553, 554</if_sid>
    <match>/etc/pve/user.cfg|/etc/pve/priv/token.cfg|/etc/pve/priv/tfa.cfg|/etc/pve/domains.cfg|/etc/pve/priv/shadow.cfg</match>
    <description>Proxmox VE: access-control configuration changed (users / API tokens / TFA / realms / ACL)</description>
    <mitre><id>T1098</id><id>T1136</id></mitre>
    <group>account_changed,syscheck,</group>
  </rule>


  <!-- ================================================================== -->
  <!-- PVE GUEST (VM/CT) OPERATIONS - decoder pve-task / pve-guest-*       -->
  <!-- ================================================================== -->

  <rule id="100815" level="10">
    <if_sid>87200</if_sid>
    <field name="pve.phase">^starting$</field>
    <field name="pve.task" type="pcre2">^(qm|vz)destroy$</field>
    <description>Proxmox VE: guest $(pve.vmid) DESTROYED by $(pve.user)</description>
    <mitre><id>T1485</id></mitre>
    <group>vm_operations,</group>
  </rule>

  <rule id="100816" level="5">
    <if_sid>87200</if_sid>
    <field name="pve.phase">^starting$</field>
    <field name="pve.task" type="pcre2">^(qm|vz)(create|clone|restore)$</field>
    <description>Proxmox VE: guest $(pve.vmid) $(pve.task) by $(pve.user)</description>
    <group>vm_operations,</group>
  </rule>

  <rule id="100817" level="7">
    <if_sid>87200</if_sid>
    <field name="pve.phase">^starting$</field>
    <field name="pve.task" type="pcre2">^(qm|vz)migrate$|^qmigrate$</field>
    <description>Proxmox VE: guest $(pve.vmid) migration started by $(pve.user)</description>
    <mitre><id>T1041</id></mitre>
    <group>vm_operations,</group>
  </rule>

  <rule id="100818" level="7">
    <if_sid>87200</if_sid>
    <field name="pve.phase">^starting$</field>
    <field name="pve.task" type="pcre2">^(qm|vz)(delsnapshot|rollback)$</field>
    <description>Proxmox VE: snapshot $(pve.task) on guest $(pve.vmid) by $(pve.user)</description>
    <mitre><id>T1490</id></mitre>
    <group>vm_operations,</group>
  </rule>

  <rule id="100819" level="8">
    <if_sid>87200</if_sid>
    <field name="pve.phase">^starting$</field>
    <field name="pve.task" type="pcre2">^(imgdel|lvmremove|lvmthinremove|zfsremove|dirremove|wipedisk)$</field>
    <description>Proxmox VE: storage/image deletion $(pve.task) ($(pve.vmid)) by $(pve.user)</description>
    <mitre><id>T1485</id></mitre>
    <group>vm_operations,storage,</group>
  </rule>

  <rule id="100820" level="3">
    <if_sid>87200</if_sid>
    <field name="pve.phase">^starting$</field>
    <field name="pve.task" type="pcre2">^(qm|vz)(start|stop|shutdown|reboot|reset|suspend|resume)$</field>
    <description>Proxmox VE: guest $(pve.vmid) $(pve.task) by $(pve.user)</description>
    <group>vm_operations,</group>
    <options>no_full_log</options>
  </rule>

  <rule id="100821" level="9" frequency="5" timeframe="60">
    <if_matched_sid>100820</if_matched_sid>
    <same_field>pve.user</same_field>
    <description>Proxmox VE: 5+ guest power operations in 60 s by $(pve.user) - scripted / mass activity</description>
    <mitre><id>T1489</id></mitre>
    <group>vm_operations,</group>
  </rule>

  <!-- task ended with an error (e.g. "VM quit/powerdown failed - got timeout") -->
  <rule id="100822" level="6">
    <if_sid>87200</if_sid>
    <field name="pve.phase">^end$</field>
    <field name="pve.status" type="pcre2">^(?!OK$)(?!WARNINGS)</field>
    <description>Proxmox VE: task $(pve.task) ($(pve.vmid)) FAILED: $(pve.status)</description>
    <group>vm_operations,</group>
  </rule>

  <rule id="100840" level="3">
    <if_sid>87200</if_sid>
    <field name="pve.params">\.</field>
    <description>Proxmox VE: $(pve.guesttype) $(pve.vmid) config updated by $(pve.actor): $(pve.params)</description>
    <group>vm_operations,config_changed,</group>
  </rule>

  <!-- risky config: arbitrary QEMU args / hookscript (persistence), PCI/USB passthrough, protection off, disk removal -->
  <rule id="100841" level="8">
    <if_sid>100840</if_sid>
    <field name="pve.params" type="pcre2">(?:^|\s)-(args|hookscript|hostpci\d*|usb\d*|protection 0)\b|-delete [^ ]*(scsi|virtio|ide|sata|efidisk|tpmstate)</field>
    <description>Proxmox VE: RISKY config change on $(pve.guesttype) $(pve.vmid) by $(pve.actor): $(pve.params)</description>
    <mitre><id>T1546</id><id>T1578</id></mitre>
    <group>vm_operations,config_changed,</group>
  </rule>


  <!-- ================================================================== -->
  <!-- PVE BACKUP (vzdump via pvescheduler / pvedaemon)                   -->
  <!-- ================================================================== -->

  <!-- verified in production logtest: this root rule wins over generic 1002 -->
  <rule id="100825" level="8">
    <program_name>pvescheduler|vzdump</program_name>
    <regex type="pcre2">(?i)vzdump.*(failed|error)|backup.*failed|Backup job finished with errors</regex>
    <description>Proxmox VE: backup FAILED (VM $(pve.vmid)): $(pve.status)</description>
    <mitre><id>T1490</id></mitre>
    <group>backup,</group>
  </rule>

  <rule id="100826" level="10" frequency="2" timeframe="3600">
    <if_matched_sid>100825</if_matched_sid>
    <same_location />
    <description>Proxmox VE: repeated backup failures (2+ in 1 h)</description>
    <mitre><id>T1490</id></mitre>
    <group>backup,</group>
  </rule>

  <rule id="100827" level="2">
    <program_name>pvescheduler|vzdump</program_name>
    <regex type="pcre2">(?i)backup job finished successfully</regex>
    <description>Proxmox VE: backup job finished successfully</description>
    <group>backup,</group>
    <options>no_full_log</options>
  </rule>

  <rule id="100828" level="8">
    <if_sid>87200</if_sid>
    <regex type="pcre2">(?i)vzdump.*(failed|error)|backup.*failed|proxmox-backup-client failed</regex>
    <description>Proxmox VE: backup FAILED (pvedaemon task)</description>
    <mitre><id>T1490</id></mitre>
    <group>backup,</group>
  </rule>

  <!-- wazuh-review 2026-09-29: pvedaemon provjerava stanje ili sadrzaj PBS storagea preko proxmox-backup-clienta (to NIJE backup):
       "proxmox-backup-client failed: Error: datastore 'x' is unavailable: offline maintenance mode" -> 210 alerta 100828 u 1,5 h.
       Najvise jedan alert na sat, kao 100829/100830. -->
  <rule id="100833" level="7" ignore="3600">
    <if_sid>100828</if_sid>
    <match>proxmox-backup-client failed</match>
    <description>Proxmox VE: PBS storage not accessible via proxmox-backup-client (status/listing, not a backup run)</description>
    <group>storage,availability,</group>
  </rule>


  <!-- ================================================================== -->
  <!-- PVE STORAGE                                                        -->
  <!-- ================================================================== -->

  <!-- "pbs2_sync: error fetching datastores - 500 Can't connect to 192.0.2.10:8007"
       ~1,300/day on pm -> at most one alert per hour -->
  <rule id="100830" level="7" ignore="3600">
    <program_name>^pvestatd$</program_name>
    <match>error fetching datastores</match>
    <description>Proxmox VE: storage "$(pve.storage)" unreachable: $(pve.status)</description>
    <group>storage,availability,</group>
  </rule>

  <rule id="100829" level="7" ignore="3600">
    <if_sid>87200</if_sid>
    <match>error fetching datastores</match>
    <description>Proxmox VE: storage "$(pve.storage)" unreachable (pvedaemon): $(pve.status)</description>
    <group>storage,availability,</group>
  </rule>

  <rule id="100831" level="7">
    <program_name>^pvestatd$</program_name>
    <regex type="pcre2">(?i)low disk space|disk space.*remaining|storage.*full</regex>
    <description>Proxmox VE: storage low on space</description>
    <group>storage,</group>
  </rule>

  <!-- not applicable today (pm and pm2 are standalone), kept for a future cluster -->
  <rule id="100832" level="9">
    <program_name>corosync|pmxcfs|pve-cluster</program_name>
    <regex type="pcre2">(?i)(node is unreachable|link.*down|lost connection to|quorum.*(lost|dissolved)|no quorum)</regex>
    <description>Proxmox VE: cluster event - node unreachable / quorum lost</description>
    <group>storage,availability,</group>
  </rule>


  <!-- ================================================================== -->
  <!-- PROXMOX BACKUP SERVER (decoder pbs-backup-proxy, proxy + api)      -->
  <!-- ================================================================== -->

  <!-- PBS 3.x "... 401 Unauthorized: [client ...] authentication failed" (not claimed by 2501) -->
  <rule id="100850" level="5">
    <program_name>^proxmox-backup-proxy$|^proxmox-backup-api$</program_name>
    <match>authentication failed</match>
    <description>PBS: authentication failed from $(srcip) ($(url))</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,pbs,</group>
  </rule>

  <!-- PBS 4.x "authentication failure; rhost=[...] [user=..] msg=..." is claimed by stock 2501 -->
  <rule id="100852" level="5">
    <if_sid>2501</if_sid>
    <program_name>^proxmox-backup-proxy$|^proxmox-backup-api$</program_name>
    <match>authentication failure; rhost=</match>
    <description>PBS: login failed for $(dstuser) from $(srcip): $(pve.status)</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,pbs,</group>
  </rule>

  <!-- expired ticket (browser tab / stale session) - audit only -->
  <rule id="100854" level="3">
    <if_sid>100852</if_sid>
    <match>invalid ticket - expired</match>
    <description>PBS: expired session ticket from $(srcip)</description>
    <group>authentication_failed,pbs,</group>
  </rule>

  <rule id="100851" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100852</if_matched_sid>
    <same_srcip />
    <description>PBS: brute force - 5+ failed logins in 2 min from $(srcip)</description>
    <mitre><id>T1110.001</id></mitre>
    <group>authentication_failures,pbs,</group>
  </rule>

  <rule id="100853" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100850</if_matched_sid>
    <same_srcip />
    <description>PBS: 5+ API authentication failures in 2 min from $(srcip)</description>
    <mitre><id>T1110.001</id></mitre>
    <group>authentication_failures,pbs,</group>
  </rule>

  <!-- 14,000+ "unable to open chunk store" per day when the NAS mount is gone -> one alert per hour -->
  <rule id="100867" level="10" ignore="3600">
    <program_name>^proxmox-backup-proxy$|^proxmox-backup-api$</program_name>
    <regex type="pcre2">(?i)unable to open chunk store|datastore '.*' is unavailable|datastore.*not available</regex>
    <description>PBS: datastore UNAVAILABLE - backups and restores fail</description>
    <mitre><id>T1490</id></mitre>
    <group>storage,availability,pbs,</group>
  </rule>

  <rule id="100868" level="8" ignore="3600">
    <program_name>^proxmox-backup-proxy$|^proxmox-backup-api$</program_name>
    <match>unable to start datastore </match>
    <description>PBS: $(pbs.jobtype) job $(pbs.jobid) could not start: $(pve.status)</description>
    <mitre><id>T1490</id></mitre>
    <group>backup,pbs,</group>
  </rule>

  <!-- "error during snapshot file listing: 'unable to load blob '".../index.json.blob"' - No such file or directory'" -->
  <rule id="100869" level="7" ignore="3600">
    <program_name>^proxmox-backup-proxy$|^proxmox-backup-api$</program_name>
    <match>error during snapshot file listing|unable to load blob</match>
    <description>PBS: datastore content error (missing/unreadable snapshot files) - verify the datastore</description>
    <mitre><id>T1490</id></mitre>
    <group>storage,pbs,</group>
  </rule>

  <!-- wazuh-review 2026-09-29: neuspjeli PBS task/job (sync, verify, prune, GC, backup) - decoder pbs-task-error.
       Prije ovoga neuspjeli pull (28.9. 00:38) i mrtvi push na drugoj lokaciji (svake noci u 00:00) nisu davali nikakav alert. -->
  <rule id="100870" level="8">
    <program_name>^proxmox-backup-proxy$|^proxmox-backup-api$|^proxmox-backup-manager$</program_name>
    <match>TASK ERROR: </match>
    <description>PBS: task FAILED - $(pve.status)</description>
    <mitre><id>T1490</id></mitre>
    <group>backup,pbs,</group>
  </rule>

  <rule id="100871" level="10" frequency="3" timeframe="86400">
    <if_matched_sid>100870</if_matched_sid>
    <same_location />
    <description>PBS: 3+ failed tasks in 24 h on the same server - backups or copies are not working</description>
    <mitre><id>T1490</id></mitre>
    <group>backup,pbs,</group>
  </rule>

  <!-- backup snapshot finished (client log uploaded) - audit, one per guest per backup run -->
  <rule id="100862" level="3">
    <program_name>^proxmox-backup-proxy$|^proxmox-backup-api$</program_name>
    <match>Upload backup log to datastore</match>
    <description>PBS: backup of $(pbs.guesttype)/$(pve.vmid) completed ($(pbs.datastore))</description>
    <group>backup,pbs,</group>
  </rule>

</group>
