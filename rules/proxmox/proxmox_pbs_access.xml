<!--
  PBS API access-log rules (2026-11 threat review)
  Decoder: decoders/proxmox/pbs_access.xml    Ingest: ingest/proxmox/localfile-snippet.xml
  ID range: 100880-100889 (inside the Proxmox 1008xx block)

  WHY: PBS writes NO log line for snapshot/group deletion or for ACL / user / API-token
  changes (verified in source): they are direct API calls, so the HTTP access log is the only
  trace. A stolen token with prune/delete rights is the backup-ransomware path.
  Confidence: MED. Path shapes are composed from the PBS API layout, not seen in a live log.
-->
<group name="proxmox,pbs,vuln_coverage,">

  <!-- 100880: a backup group or snapshot was deleted through the API -->
  <rule id="100880" level="10">
    <decoded_as>pbs-access</decoded_as>
    <action type="pcre2">^DELETE$</action>
    <url type="pcre2">/admin/datastore/[^/]+/(?:groups|snapshots)(?:\?|$)</url>
    <status>^200$</status>
    <description>PBS: backup group/snapshot deleted via API by $(dstuser) from $(srcip)</description>
    <mitre><id>T1485</id></mitre>
    <group>backup_deletion,</group>
  </rule>

  <!-- 100881: several deletions from one source in a short time = backups being wiped -->
  <rule id="100881" level="13" frequency="5" timeframe="120">
    <if_matched_sid>100880</if_matched_sid>
    <same_srcip />
    <description>PBS: 5+ backup deletions in 2 min from $(srcip) - backup destruction (ransomware pattern)</description>
    <mitre><id>T1485</id><id>T1490</id></mitre>
    <group>backup_deletion,</group>
  </rule>

  <!-- 100882: prune / garbage collection started by hand through the API -->
  <rule id="100882" level="8">
    <decoded_as>pbs-access</decoded_as>
    <action type="pcre2">^POST$</action>
    <url type="pcre2">/admin/datastore/[^/]+/(?:prune|prune-datastore|gc)(?:\?|$)</url>
    <status>^200$</status>
    <description>PBS: prune/garbage collection triggered via API by $(dstuser) from $(srcip)</description>
    <mitre><id>T1490</id></mitre>
    <group>backup_deletion,</group>
  </rule>

  <!-- 100883: ACL, user, role or API-token configuration changed through the API -->
  <rule id="100883" level="9">
    <decoded_as>pbs-access</decoded_as>
    <action type="pcre2">^(?:PUT|POST|DELETE)$</action>
    <url type="pcre2">/access/(?:acl|users|roles)(?:/|\?|$)</url>
    <status>^200$</status>
    <description>PBS: access-control change ($(action) $(url)) by $(dstuser) from $(srcip) - users, ACL or API tokens</description>
    <mitre><id>T1098</id></mitre>
    <group>account_changed,</group>
  </rule>

</group>
