<!--
  UniFi rules v2 (homelab) — wazuh-review 2026-09-26
  Replaces: /var/ossec/etc/rules/unifi_rules.xml (v1, 2026-06-04)
  Requires: decoders/unifi_decoders.xml v2 (decoders: unifi, unifi-fw, unifi-hostapd)
            rsyslog relay header normalisation (proposed/rsyslog/10-remote.conf) for sshd/sudo/hostapd lines
  Rule range: 100700-100799

  WHY v2 (evidence in IZVJESTAJ.md):
    * 100705 fired 714,516x and 100731 (level 13) 465,398x — both pure noise (allow logs, P2P IPS on the torrent VM).
    * 36 of 50 UniFi/Proxmox rules never fired: UniFi Network 10.x renamed CEF events
      ("Config Modified" instead of "Admin Made Config Changes"), dropped UNIFIsubCategory, and
      moved blocked traffic to CEF 203 "Blocked by Firewall" (no rule existed).
    * 100720/100725 were children of the generic sshd rules 5710/5716/5760/5715 on EVERY agent and
      broke stock SSH brute-force correlation 5763 (proved with wazuh-logtest: 12 failures -> 12x 100720, 0x 5763).
    * 100765 used "[0-9a-fA-F:]{17}" without type="pcre2" (OS_Regex has no {n}) -> could never match.

  RETIRED IDs (do not reuse): 100705, 100720, 100725, 100750, 100751, 100755, 100756, 100760, 100761, 100765

  Design notes:
    * Every root rule has level >= 3 so it is evaluated before the generic stock 1002 ($BAD_WORDS, level 2).
    * Demotions (e.g. P2P) are CHILDREN of the rule they demote, never siblings with a lower level.
-->

<group name="unifi,">

  <!-- ================================================================== -->
  <!-- NETFILTER (decoder unifi-fw): "[CHAIN-A|D|R-ID] DESCR=..."          -->
  <!-- ================================================================== -->

  <!-- Allowed traffic: never alert (UniFi logs ~150k allow lines/day; they filled the agent buffer). -->
  <rule id="100719" level="0">
    <decoded_as>unifi-fw</decoded_as>
    <action>A</action>
    <description>UniFi FW: allowed traffic ($(uni_chain) rule $(uni_ruleid)) - not alerted</description>
    <group>firewall,</group>
  </rule>

  <rule id="100700" level="5">
    <decoded_as>unifi-fw</decoded_as>
    <action type="pcre2">^[DR]$</action>
    <field name="uni_chain" type="pcre2">_WAN$</field>
    <description>UniFi FW: outbound traffic blocked $(srcip) -> $(dstip):$(dstport)/$(protocol) (rule "$(uni_rulename)")</description>
    <mitre><id>T1048</id></mitre>
    <group>firewall,firewall_drop,</group>
  </rule>

  <rule id="100701" level="8" frequency="10" timeframe="60">
    <if_matched_sid>100700</if_matched_sid>
    <same_srcip />
    <description>UniFi FW: 10+ blocked outbound connections in 60 s from $(srcip) - possible beaconing / exfiltration</description>
    <mitre><id>T1048</id><id>T1071</id></mitre>
    <group>firewall,firewall_drop,</group>
  </rule>

  <rule id="100702" level="4">
    <decoded_as>unifi-fw</decoded_as>
    <action type="pcre2">^[DR]$</action>
    <field name="uni_chain" type="pcre2">^WAN_</field>
    <description>UniFi FW: inbound traffic from Internet blocked $(srcip) -> $(dstip):$(dstport)/$(protocol)</description>
    <group>firewall,firewall_drop,</group>
  </rule>

  <rule id="100703" level="9" frequency="15" timeframe="60">
    <if_matched_sid>100702</if_matched_sid>
    <same_srcip />
    <different_dstport />
    <description>UniFi FW: port scan from Internet - $(srcip) hit 15+ different ports in 60 s</description>
    <mitre><id>T1595.001</id><id>T1046</id></mitre>
    <group>firewall,firewall_drop,recon,</group>
  </rule>

  <rule id="100710" level="6">
    <decoded_as>unifi-fw</decoded_as>
    <action type="pcre2">^[DR]$</action>
    <field name="uni_chain" type="pcre2">^(LAN|GUEST|VPN)_(LAN|LOCAL|GUEST)$</field>
    <description>UniFi FW: inter-VLAN traffic blocked $(srcip) -> $(dstip):$(dstport)/$(protocol) (rule "$(uni_rulename)")</description>
    <mitre><id>T1021</id></mitre>
    <group>firewall,firewall_drop,</group>
  </rule>

  <rule id="100715" level="7">
    <if_sid>100710</if_sid>
    <dstport>^22$|^23$|^445$|^3389$|^5900$|^8006$|^8007$|^8443$|^9443$|^55000$</dstport>
    <description>UniFi FW: inter-VLAN attempt to an admin port blocked $(srcip) -> $(dstip):$(dstport)</description>
    <mitre><id>T1021</id></mitre>
    <group>firewall,firewall_drop,</group>
  </rule>

  <rule id="100711" level="8" frequency="10" timeframe="60">
    <if_matched_sid>100710</if_matched_sid>
    <same_srcip />
    <description>UniFi FW: 10+ blocked inter-VLAN attempts in 60 s from $(srcip) - lateral movement</description>
    <mitre><id>T1021</id></mitre>
    <group>firewall,firewall_drop,</group>
  </rule>

  <rule id="100712" level="10" frequency="15" timeframe="60">
    <if_matched_sid>100710</if_matched_sid>
    <same_srcip />
    <different_dstport />
    <description>UniFi FW: internal port scan - $(srcip) hit 15+ different blocked ports in 60 s</description>
    <mitre><id>T1046</id></mitre>
    <group>firewall,firewall_drop,recon,</group>
  </rule>


  <!-- ================================================================== -->
  <!-- CEF - IDS/IPS "Threat Detected" (event_id 200)                     -->
  <!-- ================================================================== -->

  <rule id="100730" level="5">
    <decoded_as>unifi</decoded_as>
    <field name="event_id">^200$</field>
    <description>UniFi IPS: $(uni_signature) [risk $(uni_risk), $(action)] $(uni_srcclient) -> $(dstip):$(dstport)</description>
    <mitre><id>T1595</id></mitre>
    <group>ids,</group>
  </rule>

  <rule id="100735" level="13">
    <if_sid>100730</if_sid>
    <field name="uni_signature" type="pcre2">(?i)(command and control|\bC2\b|\bCNC\b|trojan|malware|botnet|beacon|ransom)</field>
    <description>UniFi IPS: C2 / malware signature "$(uni_signature)" from $(uni_srcclient) -> $(dstip) [$(action)]</description>
    <mitre><id>T1071</id></mitre>
    <group>ids,</group>
  </rule>

  <rule id="100736" level="13">
    <if_sid>100730</if_sid>
    <field name="uni_signature" type="pcre2">(?i)(exploit|privilege gain|web application attack|sql injection|remote code|\bRCE\b|shellcode|buffer overflow)</field>
    <description>UniFi IPS: exploit signature "$(uni_signature)" $(uni_srcclient) -> $(dstip):$(dstport) [$(action)]</description>
    <mitre><id>T1190</id><id>T1203</id></mitre>
    <group>ids,</group>
  </rule>

  <rule id="100731" level="12">
    <if_sid>100730</if_sid>
    <field name="uni_risk" type="pcre2">(?i)^(high|critical|severe)$</field>
    <description>UniFi IPS: HIGH risk "$(uni_signature)" $(uni_srcclient) -> $(dstip):$(dstport) [$(action)]</description>
    <mitre><id>T1190</id></mitre>
    <group>ids,</group>
  </rule>

  <rule id="100732" level="9">
    <if_sid>100730</if_sid>
    <field name="uni_risk" type="pcre2">(?i)^(medium|moderate)$</field>
    <description>UniFi IPS: MEDIUM risk "$(uni_signature)" $(uni_srcclient) -> $(dstip):$(dstport) [$(action)]</description>
    <group>ids,</group>
  </rule>

  <!-- High risk but already BLOCKED by the gateway (and not P2P) -->
  <rule id="100737" level="8">
    <if_sid>100731</if_sid>
    <action>blocked</action>
    <field name="uni_policy" negate="yes">^P2P$</field>
    <description>UniFi IPS: HIGH risk "$(uni_signature)" BLOCKED $(uni_srcclient) -> $(dstip):$(dstport)</description>
    <group>ids,</group>
  </rule>

  <!-- P2P category = policy audit, not an intrusion. 98 % of all IPS events (1,584,116 of 1,609,512) come from the
       torrent VM (QBT), ~8/min. Level 2 = below log_alert_level 3, i.e. NOT stored as an alert (would be ~12k/day at L3).
       Unexpected P2P clients are still alerted by child 100734 (L7). Best fix: IPS allow-list for QBT in UniFi. -->
  <rule id="100733" level="2">
    <if_sid>100731, 100732</if_sid>
    <field name="uni_policy">^P2P$</field>
    <description>UniFi IPS: P2P traffic ($(uni_signature)) from $(uni_srcclient) - policy audit</description>
    <group>ids,policy,</group>
  </rule>

  <!-- ...unless it comes from a device that should NOT run P2P. MAC = torrent VM "QBT". -->
  <rule id="100734" level="7">
    <if_sid>100733</if_sid>
    <field name="uni_srcclientmac" negate="yes">^bc:24:11:7f:13:ae$</field>
    <description>UniFi IPS: P2P traffic from an unexpected client $(uni_srcclient) ($(uni_srcclientmac)) - policy violation</description>
    <mitre><id>T1071</id></mitre>
    <group>ids,policy,</group>
  </rule>


  <!-- ================================================================== -->
  <!-- CEF - "Blocked by Firewall" (event_id 203, zone-based firewall)    -->
  <!-- ================================================================== -->

  <rule id="100770" level="4">
    <decoded_as>unifi</decoded_as>
    <field name="event_id">^203$</field>
    <description>UniFi FW: $(uni_srcclient) ($(uni_srcclientip)) blocked -> $(dstip):$(dstport) by policy "$(uni_fwpolicy)"</description>
    <group>firewall,firewall_drop,</group>
  </rule>

  <rule id="100771" level="8" frequency="20" timeframe="300">
    <if_matched_sid>100770</if_matched_sid>
    <same_field>uni_srcclientip</same_field>
    <description>UniFi FW: 20+ blocked connections in 5 min from $(uni_srcclient) ($(uni_srcclientip)) - misconfigured or compromised device</description>
    <mitre><id>T1071</id></mitre>
    <group>firewall,firewall_drop,</group>
  </rule>


  <!-- ================================================================== -->
  <!-- CEF - administration / audit                                        -->
  <!--   Network 10.x: 544 Network Accessed, 545 Config Created,          -->
  <!--                 546 Config Modified, 547 Config Paused, 549 Removed -->
  <!--   Network 10.0: 544 Admin Accessed UniFi Network, 545/546 Admin ... -->
  <!--   UniFi OS 5.x: 1000 Admin Accessed UniFi OS, 1005 Admin Made Config Changes, -->
  <!--                 1020 User Deactivated, 1021 User Deleted            -->
  <!-- ================================================================== -->

  <rule id="100743" level="3">
    <decoded_as>unifi</decoded_as>
    <field name="event_id">^544$|^1000$</field>
    <description>UniFi admin: $(uni_admin) signed in to $(uni_app) via $(uni_accessmethod) from $(srcip)</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100744" level="6">
    <if_sid>100743</if_sid>
    <srcip negate="yes">10.0.0.0/8</srcip>
    <srcip negate="yes">172.16.0.0/12</srcip>
    <srcip negate="yes">192.168.0.0/16</srcip>
    <srcip negate="yes">100.64.0.0/10</srcip>
    <srcip negate="yes">127.0.0.0/8</srcip>
    <description>UniFi admin: $(uni_admin) signed in to $(uni_app) from EXTERNAL IP $(srcip)</description>
    <mitre><id>T1078.004</id></mitre>
    <group>authentication_success,</group>
  </rule>

  <rule id="100740" level="5">
    <decoded_as>unifi</decoded_as>
    <field name="event_id">^545$|^546$|^547$|^549$|^1005$</field>
    <description>UniFi config change by $(uni_admin): $(uni_event) - $(uni_section) / $(uni_entry)</description>
    <mitre><id>T1565</id></mitre>
    <group>config_changed,</group>
  </rule>

  <!-- logging / SIEM config changed = defense evasion (e.g. UNAS "changed Syslog Settings Mode") -->
  <rule id="100747" level="10">
    <if_sid>100740</if_sid>
    <regex type="pcre2">(?i)(syslog|siem|activity logging|remote logging|netconsole|debug log)</regex>
    <description>UniFi config change: LOGGING / SIEM settings changed by $(uni_admin) - possible defense evasion</description>
    <mitre><id>T1562.001</id></mitre>
    <group>config_changed,</group>
  </rule>

  <rule id="100741" level="9">
    <if_sid>100740</if_sid>
    <field name="uni_section" type="pcre2">(?i)(firewall|security|vpn|teleport|wireguard|openvpn|admin|user|radius|port forward|traffic|routing|dns|ips|ids|threat|cybersecure|ssh|remote access|gateway|control plane)</field>
    <description>UniFi config change: SECURITY section "$(uni_section)" ($(uni_entry)) changed by $(uni_admin)</description>
    <mitre><id>T1562.001</id></mitre>
    <group>config_changed,</group>
  </rule>

  <rule id="100742" level="8">
    <if_sid>100740</if_sid>
    <srcip negate="yes">10.0.0.0/8</srcip>
    <srcip negate="yes">172.16.0.0/12</srcip>
    <srcip negate="yes">192.168.0.0/16</srcip>
    <srcip negate="yes">100.64.0.0/10</srcip>
    <srcip negate="yes">127.0.0.0/8</srcip>
    <description>UniFi config change by $(uni_admin) from EXTERNAL IP $(srcip): $(uni_section) / $(uni_entry)</description>
    <mitre><id>T1078.004</id></mitre>
    <group>config_changed,</group>
  </rule>

  <rule id="100748" level="8">
    <decoded_as>unifi</decoded_as>
    <field name="uni_event" type="pcre2">(?i)^(User|Admin) (Created|Added|Invited|Deleted|Removed|Deactivated|Role)</field>
    <description>UniFi account management: $(uni_event) - $(message)</description>
    <mitre><id>T1098</id><id>T1531</id></mitre>
    <group>account_changed,</group>
  </rule>


  <!-- ================================================================== -->
  <!-- CEF - security / availability events                               -->
  <!-- ================================================================== -->

  <rule id="100775" level="10">
    <decoded_as>unifi</decoded_as>
    <field name="event_id">^529$</field>
    <description>UniFi: WiFi impersonation (rogue AP / evil twin) detected - $(message)</description>
    <mitre><id>T1557</id></mitre>
    <group>wireless,</group>
  </rule>

  <rule id="100776" level="6">
    <decoded_as>unifi</decoded_as>
    <field name="event_id">^539$</field>
    <description>UniFi: device IP address conflict - $(message)</description>
    <group>network,</group>
  </rule>

  <rule id="100777" level="5">
    <decoded_as>unifi</decoded_as>
    <field name="event_id">^522$</field>
    <description>UniFi VPN: Teleport client connected - $(message)</description>
    <group>vpn,</group>
  </rule>

  <rule id="100778" level="3">
    <decoded_as>unifi</decoded_as>
    <field name="event_id">^523$</field>
    <description>UniFi VPN: Teleport client disconnected - $(message)</description>
    <group>vpn,</group>
  </rule>

  <!-- Policy-based route (e.g. "NordVPN route" for the torrent VM) stopped -> traffic may leave via the default WAN -->
  <rule id="100779" level="5">
    <decoded_as>unifi</decoded_as>
    <field name="event_id">^543$</field>
    <description>UniFi: policy-based route "$(uni_pbr)" STOPPED for $(uni_clientdev) - check VPN kill switch</description>
    <group>vpn,</group>
  </rule>

  <rule id="100780" level="3">
    <decoded_as>unifi</decoded_as>
    <field name="event_id">^542$</field>
    <description>UniFi: policy-based route "$(uni_pbr)" started for $(uni_clientdev)</description>
    <group>vpn,</group>
  </rule>

  <rule id="100781" level="7">
    <decoded_as>unifi</decoded_as>
    <field name="event_id">^100$</field>
    <description>UniFi WAN: Internet down - $(message)</description>
    <group>availability,</group>
  </rule>

  <rule id="100782" level="8">
    <decoded_as>unifi</decoded_as>
    <field name="event_id">^101$</field>
    <description>UniFi WAN: multiple Internet disconnections - $(message)</description>
    <group>availability,</group>
  </rule>

  <rule id="100783" level="3">
    <decoded_as>unifi</decoded_as>
    <field name="event_id">^104$|^107$|^112$|^113$</field>
    <description>UniFi WAN: $(uni_event) - $(message)</description>
    <group>availability,</group>
  </rule>

  <rule id="100786" level="3">
    <decoded_as>unifi</decoded_as>
    <field name="event_id">^510$|^1100$|^1102$|^1111$</field>
    <description>UniFi: $(uni_event) - $(message)</description>
    <group>update,</group>
  </rule>

  <rule id="100788" level="3">
    <decoded_as>unifi</decoded_as>
    <field name="event_id">^1103$</field>
    <description>UniFi OS: scheduled backup created on $(uni_devname)</description>
    <group>backup,</group>
  </rule>

  <!-- Catch-all for NEW high-severity CEF types (UniFi keeps adding/renaming events).
       Level 4: below every specific rule for sev>=7 events (100730=5, 100776=6, 100781=7, 100782=8). -->
  <rule id="100789" level="4">
    <decoded_as>unifi</decoded_as>
    <field name="uni_severity" type="pcre2">^([7-9]|10)$</field>
    <description>UniFi: unclassified high-severity CEF event $(event_id) "$(uni_event)" - add a specific rule</description>
    <group>unclassified,</group>
  </rule>

  <!-- Client connect/disconnect (400/401/403/404): ~1,000/day, not alerted -->
  <rule id="100790" level="0">
    <decoded_as>unifi</decoded_as>
    <field name="event_id">^400$|^401$|^403$|^404$</field>
    <description>UniFi: client $(uni_event) $(uni_clientdev) ($(uni_clientmac)) - not alerted</description>
    <group>wireless,</group>
  </rule>


  <!-- ================================================================== -->
  <!-- hostapd (after rsyslog normalisation): not alerted, fields for dashboards -->
  <!-- ================================================================== -->
  <rule id="100791" level="0">
    <decoded_as>unifi-hostapd</decoded_as>
    <description>UniFi hostapd: $(uni_action)$(uni_wpa) $(srcmac) on $(uni_iface) - not alerted</description>
    <group>wireless,</group>
  </rule>

</group>
