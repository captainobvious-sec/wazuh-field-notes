</group>

<!-- ============================================================
     PowerShell Module Logging (Event ID 4103) — custom rules
     IDs 100470-100499

     CONSOLIDATED 2026-07-08: these 4103 module-logging rules were merged INTO
     this file (per operator preference for a single PowerShell rule file). The
     former separate file 106-ps_module_logging_windows.xml has been emptied so
     the IDs 100470-100485 are declared exactly once. 4104 script-block rules are
     above (100400-100462); 4103 cmdlet/pipeline rules are below and carry the
     invoking user SID ($(win.system.securityUserID)).

     Routing (2026-07-08): 100472 PROMOTED to email (alert_by_email);
     100473/100477/100479/100485 DEMOTED to digest (no_email_alert). The Defender
     hard-kill child of 100477 that stays Tier-1 is 100606 in 107-alert_tuning.
     ============================================================ -->
<group name="windows,powershell,module_logging,">

  <!-- ===================== base router ===================== -->
  <rule id="100470" level="0">
    <if_sid>91801</if_sid>
    <field name="win.system.eventID">^4103$</field>
    <options>no_full_log</options>
    <description>PS Module: pipeline execution logged (4103) on $(win.system.computer)</description>
    <group>powershell_module,</group>
  </rule>

  <!-- ===================== recon / discovery ===================== -->

  <!-- Native AD RSAT cmdlet enumeration -->
  <rule id="100471" level="8">
    <if_sid>100470</if_sid>
    <field name="win.eventdata.payload" type="pcre2">(?i)\bGet-AD(User|Group|Computer|GroupMember|Domain|DomainController|Trust|Object|ServiceAccount|OrganizationalUnit|DefaultDomainPasswordPolicy)\b</field>
    <options>no_full_log</options>
    <description>PS Module Recon: AD enumeration cmdlet by SID $(win.system.securityUserID) on $(win.system.computer)</description>
    <mitre>
      <id>T1087.002</id>
    </mitre>
    <group>recon,discovery,ad_enumeration,</group>
  </rule>

  <!-- PowerView / offensive domain recon toolkit -->
  <rule id="100472" level="10">
    <if_sid>100470</if_sid>
    <field name="win.eventdata.payload" type="pcre2">(?i)\b(Get-Domain(User|Group|Computer|Controller|Trust|GroupMember|Policy)?|Get-Net(User|Group|Computer|Session|LocalGroup|Share|Domain)|Invoke-(UserHunter|ShareFinder|Kerberoast|ACLScanner)|Find-(LocalAdminAccess|InterestingDomainAcl|DomainShare)|Get-ObjectAcl|Get-DomainObjectAcl)\b</field>
    <!-- ROUTING 2026-07-08: PROMOTED to Tier-1 email (alert_by_email) despite L10.
         PowerView-class offensive toolkit cmdlets belong with the credential-theft
         family (100340/100474); no legitimate admin generator. -->
    <options>no_full_log</options>
    <options>alert_by_email</options>
    <description>PS Module Recon: offensive AD toolkit (PowerView-class) by SID $(win.system.securityUserID) on $(win.system.computer)</description>
    <mitre>
      <id>T1087.002</id>
      <id>T1069.002</id>
    </mitre>
