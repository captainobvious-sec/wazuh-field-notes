<!-- ============================================================
     DEFAULT-RULE ROUTING OVERRIDES — Windows
     Created 2026-07-08 (alerting-discipline review).

     WHY THIS FILE EXISTS
     We must not e-mail on a handful of noisy Wazuh DEFAULT rules, and we must
     e-mail on two that ship below threshold. Editing the shipped default files
     (/var/ossec/ruleset/rules/*) is the WRONG way: custom deployments never
     touch that directory, and a Wazuh upgrade overwrites it. This is a CUSTOM
     file (etc/rules/), so it is deployed with the other custom files AND
     survives upgrades.

     HOW IT WORKS
     overwrite="yes" replaces the default rule of the same id. Custom rules in
     etc/rules load AFTER ruleset/rules, so the override always wins — and
     analysisd does NOT raise a duplicate-id warning (that is what overwrite is
     for). Each rule body below is an exact copy of the shipped default with a
     single routing option added; if a future Wazuh version changes one of these
     rule bodies, re-copy it here so the override stays faithful.

     DEMOTED (no_email_alert): 91822/91823 remote Invoke-Command (was the biggest
     noise source - double-emailed every remote command), 91803 screen-capture,
     60015 multiple-critical aggregate, 92650 %systemroot% service, 92655
     PrintNightmare driver-load failure, 60162/60171/60187/60188/60189
     Guests/RODC/Crypto group changes; 204 agent event queue flooded (2026-09-30,
     all agents - in its own <group> block at the end of this file).
     (Crown-jewel group changes 60154/60156/60159/60164/60166/60167/60176 are
      NOT here - they stay Tier-1 and keep e-mailing by the level-12 threshold.)

     PROMOTED (level 8-10 -> 12, e-mails; 2026-09-24, REVIEW.md F-16):
     60168 Group Policy Creator Owners, 60173 Account Operators,
     60174 Server Operators. (Print Operators is custom rule 100366 in 104: an
     overwrite keeps the rule's load-time position, and stock 60175 (L8) sits behind
     the custom generic rule 100311 (L10), so an overwrite of 60175 is never reached.)
     ============================================================ -->
<group name="windows,default_override,">
  <rule id="91822" level="12" overwrite="yes">
    <if_sid>91802</if_sid>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)Invoke-Command</field>
    <options>no_full_log</options>
    <options>no_email_alert</options>
    <description>Powershell script used "Invoke-command" cmdlet to execute sub script</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <rule id="91823" level="14" overwrite="yes">
    <if_sid>91822</if_sid>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)(ComputerName|Cn)</field>
    <options>no_full_log</options>
    <options>no_email_alert</options>
    <description>Powershell script used "Invoke-command" cmdlet to execute code on remote computer</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1021.006</id>
    </mitre>
  </rule>

  <rule id="91803" level="14" overwrite="yes">
    <if_sid>91802</if_sid>
    <field name="win.system.message" type="pcre2">CopyFromScreen</field>
    <options>no_full_log</options>
    <options>no_email_alert</options>
    <description>Screen capture method invoked from PowerShell script.</description>
    <mitre>
      <id>T1113</id>
    </mitre>
  </rule>

  <rule id="60015" level="12" frequency="4" timeframe="240" overwrite="yes">
