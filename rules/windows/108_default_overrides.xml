<!-- ===== Wazuh agent health: applies to ALL agents, not only Windows =====
     DEMOTED 2026-09-30 (no_email_alert): 204 "Agent event queue is flooded".
     It sent 10-15 e-mails a day for one agent. It is an operational
     signal, not an attack, so it goes to the dashboards, not the Tier-1 mailbox.
     It still MATTERS: "flooded" means the agent's client buffer stayed full and
     the agent is DISCARDING events, so that host is partly blind until the cause
     is fixed (a noisy event channel, or a client_buffer that is too small).
     Own <group> block because an overwrite takes the groups of the block it sits
     in: the rule keeps the stock "wazuh" group and does not get "windows" (it
     also fires for Linux agents and for the syslog relay).
     Body copied from stock 0016-wazuh_rules.xml; only no_email_alert is added. -->
<group name="wazuh,default_override,">
  <rule id="204" level="12" overwrite="yes">
    <if_sid>201</if_sid>
    <field name="level">flooded</field>
    <options>no_email_alert</options>
    <description>Agent event queue is flooded. Check the agent configuration.</description>
    <group>agent_flooding,pci_dss_10.6.1,gdpr_IV_35.7.d,</group>
  </rule>
</group>
